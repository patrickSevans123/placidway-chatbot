# Copy to .env and fill in. Never commit the real file.

# Any OpenAI-compatible endpoint. This deployment points at a local router.
LLM_BASE_URL=https://9router.patricksamuel.ninja/v1
LLM_API_KEY=
LLM_MODEL=gh/gpt-4.1
LLM_FALLBACKS=ag/gemini-3-flash,ag/gemini-3.5-flash-low,small-task

# Retrieval
TOP_K=8
USE_DENSE=1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MIN_RETRIEVAL_SCORE=0.40

# Ingestion
CRAWL_DELAY=3.0

# Admin endpoints (refresh, unanswered log). Leave empty to disable them.
ADMIN_TOKEN=
