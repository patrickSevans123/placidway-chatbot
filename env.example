# Copy to .env and fill in. Never commit the real file.

# Any OpenAI-compatible endpoint. Mistral is the default.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-1-flash-1017
LLM_FALLBACKS=mistral-large-latest,mistral-small-latest

# Retrieval
TOP_K=8
USE_DENSE=1
# api = same endpoint as the chat model; local = fastembed (optional); none = BM25 only
EMBEDDING_BACKEND=api
EMBEDDING_MODEL=mistral-embed
MIN_RETRIEVAL_SCORE=0.40

# Ingestion
CRAWL_DELAY=3.0

# Admin endpoints (refresh, unanswered log). Leave empty to disable them.
ADMIN_TOKEN=