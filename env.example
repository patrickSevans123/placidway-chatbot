# Copy to .env and fill in. Never commit the real file.

# Generation: any OpenAI-compatible endpoint. OpenCode Go is the default: it is
# an OpenAI-compatible gateway with a monthly allowance rather than per-token
# billing, and it serves the same model this project was evaluated on.
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
LLM_FALLBACKS=deepseek-v4-pro
# The gateway asks clients to identify themselves and to send a stable session id.
LLM_USER_AGENT=PlacidWayAssessmentBot/1.0
LLM_SESSION_ID=placidway-guide
# "none" keeps a reasoning model from spending a small max_tokens budget before it
# writes anything. Empty means the field is not sent, for providers that reject it.
LLM_REASONING_EFFORT=none

# Retrieval
TOP_K=8
# Dense half of the hybrid. On: the answer-level evaluation scores 24/24 with it
# and 22/24 without. The retrieval benchmark disagrees; docs/EVALUATION.md has both
# numbers and the reason the hybrid still ships. Set to 0 to reproduce that side.
USE_DENSE=1
# api = an OpenAI-compatible /embeddings endpoint; local = fastembed (optional);
# none = BM25 only. The Go gateway serves chat models only, so embeddings keep
# their own base URL and key. Both fall back to LLM_* when unset, which is what a
# single-provider deployment wants.
EMBEDDING_BACKEND=api
EMBEDDING_BASE_URL=https://api.mistral.ai/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=mistral-embed
MIN_RETRIEVAL_SCORE=0.40

# Ingestion
CRAWL_DELAY=3.0

# Where the refresh history lives. Inside a container, point this at a mounted
# volume so a redeploy does not reset it. Empty means data/refresh_state.json.
REFRESH_STATE_PATH=

# Admin endpoints (refresh, unanswered log). Leave empty to disable them.
ADMIN_TOKEN=

# Rate limit on POST /api/chat and POST /api/lead, per visitor IP.
# Set to 0 to turn the limit off; 1 to enable it.
RATE_LIMIT_ENABLED=1
# Requests allowed per IP inside one window.
RATE_LIMIT_REQUESTS=20
# Window length in seconds.
RATE_LIMIT_WINDOW=60
